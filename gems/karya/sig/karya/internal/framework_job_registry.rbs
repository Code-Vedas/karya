module Karya
  module Internal
    module FrameworkJobRegistry
      class Entry < Struct[singleton(Karya::FrameworkJob::Base) | String?]
        @klass: singleton(Karya::FrameworkJob::Base)
        @source_path: String?

        attr_accessor klass: singleton(Karya::FrameworkJob::Base)
        attr_accessor source_path: String?

        def initialize: (?klass: singleton(Karya::FrameworkJob::Base), ?source_path: String?) -> void
        def framework_job_class?: (singleton(Karya::FrameworkJob::Base) job_base) -> bool
      end

      def self.register: (singleton(Karya::FrameworkJob::Base) klass, source_path: String?) -> singleton(Karya::FrameworkJob::Base)
      def self.entries: () -> Array[Entry]
      def self.reset!: () -> void
    end
  end
end
