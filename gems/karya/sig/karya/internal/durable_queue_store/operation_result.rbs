module Karya
  module Internal
    module DurableQueueStore
      class OperationResult
        def initialize: (value: value, mutation_plan: MutationPlan, persist: bool) -> void

        attr_reader value: value
        attr_reader mutation_plan: MutationPlan

        def persist?: () -> bool
      end
    end
  end
