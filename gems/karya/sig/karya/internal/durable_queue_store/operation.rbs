module Karya
  module Internal
    module DurableQueueStore
      class Operation
        def initialize: (store: persisted_store, request: request) -> void

        attr_reader store: persisted_store
        attr_reader request: request

        def call: (context: OperationContext) -> OperationResult
      end
    end
  end
end
