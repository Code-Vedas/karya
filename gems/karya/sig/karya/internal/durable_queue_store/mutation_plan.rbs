module Karya
  module Internal
    module DurableQueueStore
      class MutationPlan
        def initialize: (
          ?metadata_updates: metadata,
          ?inserts: rows,
          ?updates: rows,
          ?deletes: rows
        ) -> void

        attr_reader metadata_updates: metadata
        attr_reader inserts: rows
        attr_reader updates: rows
        attr_reader deletes: rows

        def empty?: () -> bool
      end
    end
  end
end
