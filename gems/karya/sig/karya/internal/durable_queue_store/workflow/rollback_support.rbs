module Karya
  module Internal
    module DurableQueueStore
      module WorkflowRuntimeSupport
        module RollbackBatchIdentifier
          private

          def rollback_batch_id_for: (String) -> String
        end

        module RollbackEligibility
          private

          def validate_rollback_snapshot: (Workflow::Snapshot, Hash[String, Array[String]]) -> void
          def rollback_runnable_waiting_job?: (Job, Hash[String, Array[String]], Array[Job]) -> bool
          def rollback_eligible_snapshot?: (Workflow::Snapshot, Hash[String, Array[String]]) -> bool
          def rollback_rejection_message: (Workflow::Snapshot, Hash[String, Array[String]]) -> String
        end

        class RollbackSnapshotEligibility
          def initialize: (snapshot: Workflow::Snapshot, dependency_job_ids_by_job_id: Hash[String, Array[String]]) -> void
          def eligible?: () -> bool
          def rejection_message: () -> String
          def runnable_waiting_job?: (Job) -> bool
        end

        module RollbackSupport
          include RollbackBatchIdentifier
          include RollbackEligibility
        end
      end
    end
  end
end
