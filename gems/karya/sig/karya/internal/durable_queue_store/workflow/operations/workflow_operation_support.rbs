          ) -> void
          def build: () -> Job?
        end

        class WorkflowEnqueueInsertBuilder
          def initialize: (
            operation: Operation,
            enqueue_request: WorkflowEnqueueRequest
          ) -> void
          def build: () -> rows
        end

        class RollbackRequest
          attr_reader now: Time
          attr_reader batch_id: String
          attr_reader rows: runtime_rows
          attr_reader rollback_plan: RollbackPlan
          attr_reader registration: WorkflowRuntimeSupport::WorkflowRegistration
          attr_reader rollback_batch_id: String
          attr_reader rollback_step_ids: Array[Symbol]
          attr_reader queued_jobs: Array[Job]
          attr_reader reason: String

          def initialize: (
            now: Time,
            batch_id: String,
            rows: runtime_rows,
            rollback_plan: RollbackPlan
          ) -> void
        end

        class RollbackPlan
          attr_reader registration: WorkflowRuntimeSupport::WorkflowRegistration
          attr_reader rollback_batch_id: String
          attr_reader rollback_step_ids: Array[Symbol]
          attr_reader queued_jobs: Array[Job]
          attr_reader reason: String

          def initialize: (
            registration: WorkflowRuntimeSupport::WorkflowRegistration,
            rollback_batch_id: String,
            rollback_step_ids: Array[Symbol],
            queued_jobs: Array[Job],
            reason: String
          ) -> void
        end

        class RollbackJobsBuilder
          def initialize: (
            snapshot: Workflow::Snapshot,
            registration: WorkflowRuntimeSupport::WorkflowRegistration
          ) -> void
          def build: () -> Array[[Symbol, Job]]
        end

        class RollbackRequestBuilder
          def initialize: (operation: Operation, context: OperationContext) -> void
          def build: () -> RollbackRequest
        end

        class RollbackRegistrationBuilder
          def initialize: (
            registration: WorkflowRuntimeSupport::WorkflowRegistration,
            rollback_step_ids: Array[Symbol],
            queued_jobs: Array[Job]
          ) -> void
          def build: () -> WorkflowRuntimeSupport::WorkflowRegistration
        end

        class RollbackHistoryDetails
          def initialize: (queued_jobs: Array[Job]) -> void
          def to_h: () -> Hash[String, durable_value]
        end

        class RollbackInsertBuilder
          def initialize: (operation: Operation, namespace: String, rollback_request: RollbackRequest) -> void
          def build: () -> rows
        end

        class ChildWorkflowInsertBuilder
          def initialize: (operation: Operation, namespace: String, child_request: ChildWorkflowRequest) -> void
          def build: () -> rows
        end

        module WorkflowOperationSupport
          include WorkflowEnqueueSupport
          include WorkflowRuntimeContextSupport

          private

          def normalized_workflow_now: () -> Time
          def normalized_workflow_batch_id: (?field_name: Symbol) -> String
        end
      end
    end
  end
