          def initialize: (
            operation: Operation,
            mutation: WorkflowStepBulkOperation::WorkflowBulkMutation,
            now: Time
          ) -> void
          def build: () -> Job?
        end

        class DeadLetterWorkflowStepTransitionBuilder
          def initialize: (
            mutation: WorkflowStepBulkOperation::WorkflowBulkMutation,
            now: Time,
            reason: String
          ) -> void
          def build: () -> Job?
        end

        class ReplayWorkflowStepTransitionBuilder
          def initialize: (
            operation: Operation,
            mutation: WorkflowStepBulkOperation::WorkflowBulkMutation,
            now: Time
          ) -> void
          def build: () -> Job?
        end

        class RetryDeadLetterWorkflowStepTransitionBuilder
          def initialize: (
            operation: Operation,
            mutation: WorkflowStepBulkOperation::WorkflowBulkMutation,
            now: Time,
            next_retry_at: Time
          ) -> void
          def build: () -> Job?
