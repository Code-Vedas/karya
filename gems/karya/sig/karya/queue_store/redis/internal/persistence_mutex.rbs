module Karya
  module QueueStore
    class Redis
      module Internal
        class PersistenceMutex
          def initialize: (redis: ::Redis, owner: Karya::QueueStore::Redis, durable_state_store: Karya::QueueStore::Redis::Internal::DurableStateStore, lock_key: String, version_key: String) -> void
          def run_mutation: [T] (?operation_name: Symbol?) { () -> T } -> T
          def run_reserve: [T] (?operation_name: Symbol?) { () -> T } -> T
          def run_read_only: [T] (?operation_name: Symbol?) { () -> T } -> T
        end
      end
    end
  end
end
