module Karya
  module QueueStore
    module Internal
      module ReferenceQueueStore
        module Internal
        class WorkflowChildState
          @store_state: Karya::QueueStore::Internal::StoreState
          @now: Time
          @cache: Hash[String, Karya::workflow_state]
          @visiting: Hash[String, bool]

          def initialize: (
            state: Karya::QueueStore::Internal::StoreState,
            now: Time,
            ?cache: Hash[String, Karya::workflow_state],
            ?visiting: Hash[String, bool]
          ) -> void
          def resolve: (String batch_id) -> Karya::workflow_state

        private

          attr_reader store_state: Karya::QueueStore::Internal::StoreState
          attr_reader now: Time
          attr_reader cache: Hash[String, Karya::workflow_state]
          attr_reader visiting: Hash[String, bool]

          class StateSnapshot
            @batch_id: String
            @store_state: Karya::QueueStore::Internal::StoreState
            @now: Time
            @cache: Hash[String, Karya::workflow_state]
            @visiting: Hash[String, bool]

            def initialize: (
              batch_id: String,
              state: Karya::QueueStore::Internal::StoreState,
              now: Time,
              cache: Hash[String, Karya::workflow_state],
              visiting: Hash[String, bool]
            ) -> void
            def state: () -> Karya::workflow_state

          private

            attr_reader batch_id: String
            attr_reader store_state: Karya::QueueStore::Internal::StoreState
            attr_reader now: Time
            attr_reader cache: Hash[String, Karya::workflow_state]
            attr_reader visiting: Hash[String, bool]
            def batch: () -> Karya::Workflow::Batch
            def registration: () -> Karya::QueueStore::Internal::StoreState::WorkflowRegistration
            def jobs: () -> Array[Job]
            def interaction_snapshots: () -> Array[Karya::Workflow::InteractionSnapshot]
            def interaction_received_at_by_job_id: () -> Hash[String, Time]
            def approval_decisions_by_job_id: () -> Hash[String, Karya::approval_decision]
            def child_workflows: () -> Array[Karya::Workflow::ChildWorkflowSnapshot]

            class RelationshipSnapshot
              @relationship: Karya::QueueStore::Internal::StoreState::WorkflowChildren::Relationship
              @store_state: Karya::QueueStore::Internal::StoreState
              @now: Time
              @cache: Hash[String, Karya::workflow_state]
              @visiting: Hash[String, bool]

              def initialize: (
                relationship: Karya::QueueStore::Internal::StoreState::WorkflowChildren::Relationship,
                store_state: Karya::QueueStore::Internal::StoreState,
                now: Time,
                cache: Hash[String, Karya::workflow_state],
                visiting: Hash[String, bool]
              ) -> void
              def to_snapshot: () -> Karya::Workflow::ChildWorkflowSnapshot

            private

              attr_reader relationship: Karya::QueueStore::Internal::StoreState::WorkflowChildren::Relationship
              attr_reader store_state: Karya::QueueStore::Internal::StoreState
              attr_reader now: Time
              attr_reader cache: Hash[String, Karya::workflow_state]
              attr_reader visiting: Hash[String, bool]
              def child_batch_id: () -> String
              def child_state: () -> Karya::workflow_state
            end
          end
        end
      end
    end
  end
end
end
