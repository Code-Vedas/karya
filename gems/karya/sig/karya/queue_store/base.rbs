module Karya
  module QueueStore
    # Backend-facing contract for queue persistence and reservation behavior.
    module Base
      def enqueue: (job: Job, now: Time) -> Job

      def enqueue_many: (jobs: Array[Job], now: Time, ?batch_id: Karya::state_name?) -> Internal::BulkMutationReport

      def batch_snapshot: (batch_id: Karya::state_name, now: Time) -> Karya::Workflow::BatchSnapshot

      def enqueue_workflow: (
        definition: Karya::Workflow::Definition,
        jobs_by_step_id: Hash[Karya::state_name, Job],
        batch_id: Karya::state_name,
        now: Time,
        ?compensation_jobs_by_step_id: Hash[Karya::state_name, Job]
      ) -> Internal::BulkMutationReport

      def workflow_snapshot: (batch_id: Karya::state_name, now: Time) -> Karya::Workflow::Snapshot
      def workflow_history: (batch_id: Karya::state_name, now: Time) -> Karya::Workflow::HistorySnapshot
      def query_workflow: (
        batch_id: Karya::state_name,
        query: Karya::state_name,
        now: Time
      ) -> Karya::Workflow::QueryResult

      def deliver_workflow_signal: (
        batch_id: Karya::state_name,
        signal: Karya::state_name,
        payload: Karya::interaction_payload,
        now: Time
      ) -> Internal::BulkMutationReport

      def deliver_workflow_event: (
        batch_id: Karya::state_name,
        event: Karya::state_name,
        payload: Karya::interaction_payload,
        now: Time
      ) -> Internal::BulkMutationReport

      def pause_workflow: (batch_id: Karya::state_name, now: Time) -> Internal::BulkMutationReport

      def resume_workflow: (batch_id: Karya::state_name, now: Time) -> Internal::BulkMutationReport

      def approve_workflow_checkpoints: (
        batch_id: Karya::state_name,
        step_ids: Array[Karya::state_name],
        now: Time
      ) -> Internal::BulkMutationReport

      def reject_workflow_checkpoints: (
        batch_id: Karya::state_name,
        step_ids: Array[Karya::state_name],
        now: Time,
        reason: String
      ) -> Internal::BulkMutationReport

      def enqueue_child_workflow: (
        parent_batch_id: Karya::state_name,
        parent_step_id: Karya::state_name,
        definition: Karya::Workflow::Definition,
        jobs_by_step_id: Hash[Karya::state_name, Job],
        batch_id: Karya::state_name,
        now: Time,
        ?compensation_jobs_by_step_id: Hash[Karya::state_name, Job]
      ) -> Internal::BulkMutationReport

      def sync_child_workflows: (parent_batch_id: Karya::state_name, now: Time) -> Internal::BulkMutationReport

      def rollback_workflow: (batch_id: Karya::state_name, now: Time, reason: String) -> Internal::BulkMutationReport

      def retry_workflow_steps: (batch_id: Karya::state_name, step_ids: Array[Karya::state_name], now: Time) -> Internal::BulkMutationReport

      def dead_letter_workflow_steps: (
        batch_id: Karya::state_name,
        step_ids: Array[Karya::state_name],
        now: Time,
        reason: String
      ) -> Internal::BulkMutationReport

      def replay_workflow_steps: (batch_id: Karya::state_name, step_ids: Array[Karya::state_name], now: Time) -> Internal::BulkMutationReport

      def retry_dead_letter_workflow_steps: (
        batch_id: Karya::state_name,
        step_ids: Array[Karya::state_name],
        now: Time,
        next_retry_at: Time
      ) -> Internal::BulkMutationReport

      def discard_workflow_steps: (batch_id: Karya::state_name, step_ids: Array[Karya::state_name], now: Time) -> Internal::BulkMutationReport

      def reserve: (
        worker_id: String,
        lease_duration: Karya::lease_duration_value,
        now: Time,
        ?queue: String?,
        ?queues: Array[String]?,
        ?handler_names: Array[String]?
      ) -> Reservation?

      def release: (reservation_token: String, now: Time) -> Job

      def start_execution: (reservation_token: String, now: Time) -> Job

      def complete_execution: (reservation_token: String, now: Time) -> Job

      def fail_execution: (
        reservation_token: String,
        now: Time,
        failure_classification: failure_classification_input,
        ?retry_policy: RetryPolicy?
      ) -> Job

      def retry_jobs: (job_ids: Array[String], now: Time) -> Internal::BulkMutationReport

      def cancel_jobs: (job_ids: Array[String], now: Time) -> Internal::BulkMutationReport

      def dead_letter_jobs: (job_ids: Array[String], now: Time, reason: String) -> Internal::BulkMutationReport

      def replay_dead_letter_jobs: (job_ids: Array[String], now: Time) -> Internal::BulkMutationReport

      def retry_dead_letter_jobs: (job_ids: Array[String], now: Time, next_retry_at: Time) -> Internal::BulkMutationReport

      def discard_dead_letter_jobs: (job_ids: Array[String], now: Time) -> Internal::BulkMutationReport

      def pause_queue: (queue: String, now: Time) -> Internal::QueueControlResult

      def resume_queue: (queue: String, now: Time) -> Internal::QueueControlResult

      def recover_orphaned_jobs: (worker_id: String, now: Time) -> Array[Job]

      def recover_in_flight: (now: Time) -> Internal::RecoveryReport

      def expire_reservations: (now: Time) -> Array[Job]

      def expire_jobs: (now: Time) -> Array[Job]
    end
  end
end
