module Karya
  module QueueStore
    class SQLite
      module Internal
        class PersistenceMutex
          def initialize: (connection: ::SQLite3::Database, owner: Karya::QueueStore::SQLite) -> void
          def ensure_schema: () -> nil
          def run_mutation: [T] (?operation_name: Symbol?) { () -> T } -> T
          def run_reserve: [T] (?operation_name: Symbol?) { () -> T } -> T
          def run_read_only: [T] (?operation_name: Symbol?) { () -> T } -> T
        end
      end
    end
  end
end
