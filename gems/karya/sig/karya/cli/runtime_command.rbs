module Karya
  class CLI
    class RuntimeCommand < Thor
      def self.exit_on_failure?: () -> bool

      def show: () -> nil

      def drain: () -> nil

      def force_stop: () -> nil

      private

      def runtime_control_state_file: () -> String
      def raise_runtime_control_error: (
        Karya::WorkerSupervisor::InvalidRuntimeStateFileError | Karya::WorkerSupervisor::RuntimeControlUnavailableError error
      ) -> void
    end
  end
end
