{
  "name": "karya-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "type": "module",
  "scripts": {
    "lint": "yarn exec -- eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" && stylelint \"src/**/*.scss\"",
    "build": "tsc -b && node ./node_modules/vite/bin/vite.js build",
    "prepackage-build": "yarn build && node scripts/verify-dist.mjs",
    "dev": "node ./node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 4173",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4273",
    "firefox:e2e": "yarn prepackage-build && yarn exec -- playwright test --project=firefox"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "resolutions": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "semver": "^7.8.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
