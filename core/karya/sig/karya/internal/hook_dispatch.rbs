module Karya
  module Internal
    class HookDispatch
      def self.instrument: (
        event: String,
        payload: Karya::context_payload?,
        payload_keywords: Karya::context_payload,
        payload_given: bool,
        instrumenter: Karya::instrumenter?,
        dispatch_outbound: bool,
        error_class: Karya::error_class,
        mixed_payload_message: String,
        emit_instrumentation: ^(String, Karya::context_payload) -> nil,
        emit_outbound_event: ^(String, Karya::context_payload) -> nil
      ) -> nil
    end
  end
end
