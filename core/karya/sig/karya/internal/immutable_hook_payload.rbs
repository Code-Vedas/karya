module Karya
  module Internal
    # Builds immutable snapshots for runtime hook payloads.
    class ImmutableHookPayload
      @payload: Karya::context_payload
      @error_class: Karya::error_class

      def self.snapshot: (Karya::context_payload payload, error_class: Karya::error_class) -> Karya::context_payload
      def self.snapshot_pair: (
        Karya::context_payload payload,
        error_class: Karya::error_class
      ) -> [Karya::context_payload, Karya::context_payload]

      def initialize: (Karya::context_payload payload, error_class: Karya::error_class) -> void

      def snapshot: () -> Karya::context_payload

      private

      attr_reader payload: Karya::context_payload
      attr_reader error_class: Karya::error_class
    end
  end
end
