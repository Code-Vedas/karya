module Karya
  module QueueStore
    module Internal
      module ReferenceQueueStore
        module Internal
        module WorkflowHistorySupport
          MAX_COMPENSATION_JOB_ID_PREVIEW: Integer

          def workflow_history: (batch_id: Karya::state_name, now: Time) -> Karya::Workflow::HistorySnapshot

        private

          def record_workflow_registration_history: (
            batch_id: String,
            registration: Karya::QueueStore::Internal::StoreState::WorkflowRegistration,
            occurred_at: Time
          ) -> void
          def record_workflow_step_control: (
            batch_id: String,
            registration: Karya::QueueStore::Internal::StoreState::WorkflowRegistration,
            action: Karya::bulk_mutation_action,
            job_id: String,
            occurred_at: Time
          ) -> Karya::Workflow::HistoryEntry
          def record_workflow_rollback_history: (
            batch_id: String,
            rollback_batch_id: String?,
            queued_job_ids: Array[String],
            reason: String,
            occurred_at: Time
          ) -> Karya::Workflow::HistoryEntry

          class WorkflowHistoryBuilder
            @batch: Karya::Workflow::Batch
            @registration: Karya::QueueStore::Internal::StoreState::WorkflowRegistration
            @now: Time
            @state: Karya::QueueStore::Internal::StoreState

            def initialize: (
              batch: Karya::Workflow::Batch,
              registration: Karya::QueueStore::Internal::StoreState::WorkflowRegistration,
              now: Time,
              state: Karya::QueueStore::Internal::StoreState
            ) -> void
            def to_snapshot: () -> Karya::Workflow::HistorySnapshot

          private

            attr_reader batch: Karya::Workflow::Batch
            attr_reader registration: Karya::QueueStore::Internal::StoreState::WorkflowRegistration
            attr_reader now: Time
            attr_reader state: Karya::QueueStore::Internal::StoreState
          end

          class CompensationJobDetails
            @queued_job_ids: Array[String]

            def initialize: (Array[String] queued_job_ids) -> void
            def to_h: () -> Karya::interaction_payload

          private

            attr_reader queued_job_ids: Array[String]
          end
        end
      end
    end
  end
end
end
