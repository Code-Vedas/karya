module Karya
  module QueueStore
    module Internal
      module ReferenceQueueStore
        module Internal
          module PersistenceOutcomeSupport
            private

            def reserve_with_persistence_outcome: (
              handler_matcher: HandlerMatcher,
              lease_duration: Karya::lease_duration_value,
              now: Time,
              queues: Array[String],
              subscription_key: String,
              worker_id: String
            ) -> { reservation: Reservation?, persist: bool }
            def inspection_snapshot_outcome: [A] () { () -> A } -> { snapshot: A, persist: bool }
