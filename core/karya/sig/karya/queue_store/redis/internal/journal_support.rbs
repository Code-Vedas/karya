module Karya
  module QueueStore
    class Redis
      module Internal
        class JournalSupport
          class PersistedEvent
            def initialize: (StateSnapshot::event_payload payload) -> void
            def reservation_token: () -> String?
            def replay_on: (Karya::QueueStore::Redis owner) -> void

            private

            attr_reader payload: StateSnapshot::event_payload

            def arguments: () -> Hash[String, StateSnapshot::event_payload_value]
            def name: () -> String
            def failure_classification: () -> Karya::failure_classification_input?
            def handler_names: () -> Array[String]?
            def job: () -> Karya::Job?
            def lease_duration: () -> Karya::lease_duration_value?
            def now: () -> Time?
            def queue: () -> String?
            def queues: () -> Array[String]?
            def retry_policy: () -> Karya::RetryPolicy?
            def worker_id: () -> String?
          end

          def initialize: (Karya::QueueStore::Redis owner) -> void
          def persist: [A] (
            event_builder: ^(A) -> StateSnapshot::event_payload,
            ?persist_if: ^(A) -> bool
          ) { () -> A } -> A
          def load_persisted_state: () -> void
          def event_persisted: (Integer version) -> void
          def snapshot_persisted: (Integer version) -> void
          def compact_snapshot_if_needed: () -> void

          private

          attr_reader loaded_version: Integer?
          attr_reader owner: Karya::QueueStore::Redis

          def current_persisted_version: () -> Integer
          def can_replay_incrementally?: (Integer current_version) -> bool
          def restore_state_snapshot: () -> void
          def apply_persisted_events: (Range[Integer] versions) -> void
          def apply_persisted_event: (StateSnapshot::event_payload event) -> void
          def with_journal_replay: [A] (?reservation_token: String) { () -> A } -> A
          def delete_journal_events_between: (Integer start_version, Integer end_version) -> void
          def persist_with_event: [A] (
            event_builder: ^(A) -> StateSnapshot::event_payload,
            ?persist_if: ^(A) -> bool
          ) { () -> A } -> A
          def restore_authoritative_state_after_failure: () -> nil
        end
      end
    end
  end
end
