module Karya
  module Primitives
    # Validates callable dependencies.
    class Callable[out T]
      @name: Symbol

      @value: T

      @error_class: Karya::error_class

      def initialize: (Symbol name, T value, error_class: Karya::error_class) -> void

      def normalize: () -> T

      private

      attr_reader name: Symbol

      attr_reader value: T

      attr_reader error_class: Karya::error_class
    end
  end
end
